import XCTest
@testable import Waitwise

/// Headless unit coverage for engine seeds, FocusCard lifecycle, coach daily
/// quota, Premium product id, and privacy-boundary absences required by the
/// checklist (`pm_acceptance:headless_build_and_tests`).
final class WaitwiseCoreTests: XCTestCase {

    // MARK: - Wait engine + seed content

    func testRyanmenHandWaitsAndShape() throws {
        // Same 13-tile layout as foundation ww-d1 (shapeTarget ryanmen).
        let hand = try XCTUnwrap(ContentLibrary.drill(id: "ww-d1")).handTiles
        let waits = Set(WaitEngine.winningTiles(for: hand))
        XCTAssertFalse(waits.isEmpty)
        XCTAssertTrue(waits.contains(Tile(suit: .sou, rank: 3)))
        XCTAssertTrue(waits.contains(Tile(suit: .sou, rank: 6)))
        let infos = WaitEngine.waitInfos(for: hand)
        XCTAssertTrue(infos.contains { $0.shape == .ryanmen })
    }

    func testEverySeedDrillIsTenpaiAndHitsTargetShape() {
        for drill in ContentLibrary.drills {
            XCTAssertEqual(drill.handTiles.count, 13, drill.id)
            let infos = WaitEngine.waitInfos(for: drill.handTiles)
            XCTAssertFalse(infos.isEmpty, "\(drill.id) must be tenpai")
            XCTAssertTrue(
                infos.contains { $0.shape == drill.shapeTarget },
                "\(drill.id) must include target shape \(drill.shapeTarget.rawValue)"
            )
            let counts = WaitEngine.counts(for: drill.handTiles)
            XCTAssertTrue(counts.allSatisfy { $0 <= 4 }, "\(drill.id) 4-copy limit")
        }
    }

    func testEvaluateSplitsCorrectMissedExtra() throws {
        let d1 = try XCTUnwrap(ContentLibrary.drill(id: "ww-d1"))
        let trueWaits = Set(WaitEngine.winningTiles(for: d1.handTiles))
        XCTAssertFalse(trueWaits.isEmpty)

        let oneCorrect = trueWaits.sorted().first!
        let eval = WaitEngine.evaluate(
            hand: d1.handTiles,
            selected: [oneCorrect, Tile(suit: .man, rank: 1)],
            declaredNoWaits: false
        )
        XCTAssertEqual(eval.correct, [oneCorrect])
        XCTAssertEqual(Set(eval.missed), trueWaits.subtracting([oneCorrect]))
        XCTAssertEqual(eval.extra, [Tile(suit: .man, rank: 1)])

        let noWaits = WaitEngine.evaluate(hand: d1.handTiles, selected: [], declaredNoWaits: true)
        XCTAssertEqual(Set(noWaits.missed), trueWaits)
        XCTAssertTrue(noWaits.extra.isEmpty)
        XCTAssertTrue(noWaits.correct.isEmpty)
    }

    func testGuideTopicsReferenceRealDrills() {
        for topic in ContentLibrary.guideTopics {
            if let id = topic.workedExampleDrillID {
                XCTAssertNotNil(ContentLibrary.drill(id: id), "guide \(topic.id) -> \(id)")
            }
        }
    }

    // MARK: - FocusCard lifecycle + coach quota

    @MainActor
    func testFocusCardLifecycleAndPersonalCue() throws {
        let root = FileManager.default.temporaryDirectory
            .appendingPathComponent("waitwise-tests-\(UUID().uuidString)", isDirectory: true)
        defer { try? FileManager.default.removeItem(at: root) }
        let store = LocalStore(testingDirectory: root)

        let hand = try XCTUnwrap(ContentLibrary.drill(id: "ww-d1")).handTiles
        let attempt = DrillAttempt(
            id: UUID(), drillID: "ww-d1", focusCardID: nil,
            handTiles: hand,
            selectedWaitTiles: [Tile(suit: .sou, rank: 3)],
            declaredNoWaits: false,
            correctTiles: [Tile(suit: .sou, rank: 3)],
