import SwiftUI
import UIKit

/// PM design.md "Motion & interaction language" — shared motion tokens.
/// Thesis: the user proofreads a hand tile by tile; motion only reveals changes
/// in selection, relationship, and error position. No celebration, no loops.
enum MotionLanguage {
    /// tile_settle — 180ms easeOut: tiles settle into the board / result states land.
    static let tileSettle = Animation.easeOut(duration: 0.18)
    /// map_trace — 260ms easeInOut: Wait Map edges and legend trace relationships.
    static let mapTrace = Animation.easeInOut(duration: 0.26)
    /// cue_shift — 140ms light spring: FocusCard Due/Mastered pill and cue appearance.
    static let cueShift = Animation.spring(response: 0.14, dampingFraction: 0.8)

    /// Applies `animation` only when the user has not requested Reduce Motion.
    /// Reduce Motion equivalents always update state instantly instead.
    static func animation(_ animation: Animation, reduceMotion: Bool) -> Animation? {
        reduceMotion ? nil : animation
    }
}

enum WaitwiseHaptics {
    /// haptic_select — single tile select / undo.
    static func selection() {
        UISelectionFeedbackGenerator().selectionChanged()
    }

    /// haptic_verdict — fired once per verdict: success for all-correct, warning for any miss.
    static func verdict(allCorrect: Bool) {
        let generator = UINotificationFeedbackGenerator()
        generator.notificationOccurred(allCorrect ? .success : .warning)
    }

    /// draft-anchor — warning only for an invalid 13-tile check attempt.
    static func invalidHand() {
        UINotificationFeedbackGenerator().notificationOccurred(.warning)
    }

    /// recall-turn — success only when the card turns Mastered.
    static func mastered() {
        UINotificationFeedbackGenerator().notificationOccurred(.success)
    }
}

/// Shared "reduce motion aware" transition helpers.
extension View {
    /// Instant state change when Reduce Motion is on; animated otherwise.
    func waitwiseAnimation(_ animation: Animation, value: some Equatable, reduceMotion: Bool) -> some View {
        self.animation(MotionLanguage.animation(animation, reduceMotion: reduceMotion), value: value)
    }
import Foundation

/// Local-first persistence (PM data-model.md): every entity lives on-device as
/// JSON in the app sandbox. No account, no sync, no analytics.
@MainActor
final class LocalStore: ObservableObject {
    @Published private(set) var attempts: [DrillAttempt] = []
    @Published private(set) var focusCards: [FocusCard] = []
    @Published private(set) var handStudies: [HandStudy] = []
    @Published var draft: PracticeDraft = .empty { didSet { scheduleSave() } }
    @Published private(set) var coachUsage = CoachUsage() { didSet { scheduleSave() } }

    private let fileURL: URL
    private var saveTask: Task<Void, Never>?

    init() {
        let dir = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0]
        fileURL = dir.appendingPathComponent("waitwise-store.json")
        load()
    }

    /// Isolated store for unit tests — never touches the live Documents JSON.
    init(testingDirectory: URL) {
        try? FileManager.default.createDirectory(at: testingDirectory, withIntermediateDirectories: true)
        fileURL = testingDirectory.appendingPathComponent("waitwise-store.json")
        // Start empty; do not load production state.
    }

    // MARK: - Snapshot files (TableSnapshot sandbox copies)

    var snapshotDirectory: URL {
        let dir = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0]
            .appendingPathComponent("snapshots", isDirectory: true)
        try? FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
        return dir
    }

    func snapshotURL(fileName: String) -> URL {
        snapshotDirectory.appendingPathComponent(fileName)
    }

    func saveSnapshot(data: Data, source: String, altText: String) -> TableSnapshotInfo? {
        let fileName = "snap-\(UUID().uuidString).jpg"
        let url = snapshotURL(fileName: fileName)
        do {
            try data.write(to: url, options: .atomic)
            return TableSnapshotInfo(fileName: fileName, source: source, createdAt: Date(), altText: altText)
        } catch {
            return nil
        }
    }

    func deleteSnapshot(fileName: String) {
        try? FileManager.default.removeItem(at: snapshotURL(fileName: fileName))
    }

    // MARK: - Attempts

    @discardableResult
    func recordAttempt(_ attempt: DrillAttempt) -> DrillAttempt {
        attempts.insert(attempt, at: 0)
        // Submitted: clear the matching preserved drill selection.
        draft.drillSelections.removeValue(forKey: attempt.drillID)
        scheduleSave()
        return attempt
    }

    // MARK: - FocusCards

    /// Add to Recall — explicit user action only; all-correct results never call this.
    @discardableResult
    func createFocusCard(fromAttempt attempt: DrillAttempt, shapeKey: ShapeKey) -> FocusCard {
        if let existing = focusCards.first(where: { $0.sourceAttemptID == attempt.id }) {
            return existing
        }
        let card = FocusCard(
            id: UUID(), sourceAttemptID: attempt.id, handStudyID: nil,
            handTiles: attempt.handTiles,
            missedTileIDs: attempt.missedTiles, extraTileIDs: attempt.extraTiles,
            shapeKey: shapeKey, dueState: .due, lastPracticedAt: nil,
            masteryCount: 0, personalCue: nil)
        focusCards.insert(card, at: 0)
        scheduleSave()
        return card
    }

    @discardableResult
    func createFocusCard(fromStudy study: HandStudy, missed: [Tile], extra: [Tile], shapeKey: ShapeKey) -> FocusCard {
        if let existing = focusCards.first(where: { $0.handStudyID == study.id }) {
            return existing
        }
        let card = FocusCard(
            id: UUID(), sourceAttemptID: nil, handStudyID: study.id,
            handTiles: study.virtualTiles,
            missedTileIDs: missed, extraTileIDs: extra,
            shapeKey: shapeKey, dueState: .due, lastPracticedAt: nil,
            masteryCount: 0, personalCue: nil)
        focusCards.insert(card, at: 0)
        scheduleSave()
        return card
