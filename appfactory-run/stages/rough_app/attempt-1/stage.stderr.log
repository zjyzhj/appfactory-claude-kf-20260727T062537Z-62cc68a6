import SwiftUI

@main
struct WaitwiseApp: App {
    @StateObject private var appState = AppState()

    var body: some Scene {
        WindowGroup {
            RootTabView()
                .environmentObject(appState)
                .environmentObject(appState.store)
                .environmentObject(appState.premium)
                .onAppear {
                    CoachBootstrap.registerIfAvailable()
                }
        }
    }
}

/// Registers the sealed Coach provider when the credential package generated a
/// client; otherwise the drill-result surface stays on the free local cue.
enum CoachBootstrap {
    @MainActor
    static func registerIfAvailable() {
        #if canImport(Foundation)
        if let provider = SealedCoachProviderFactory.makeIfAvailable() {
            CoachProviderRegistry.provider = provider
        }
        #endif
    }
}
