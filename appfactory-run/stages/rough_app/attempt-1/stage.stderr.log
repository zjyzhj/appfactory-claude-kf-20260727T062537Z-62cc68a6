    @MainActor
    func testCoachDailyLimitCountsOnlySuccessfulResults() {
        let root = FileManager.default.temporaryDirectory
            .appendingPathComponent("waitwise-coach-\(UUID().uuidString)", isDirectory: true)
        defer { try? FileManager.default.removeItem(at: root) }
        let store = LocalStore(testingDirectory: root)

        XCTAssertEqual(LocalStore.coachDailyLimit, 3)
        XCTAssertEqual(store.coachUsesRemainingToday, 3)
        store.recordSuccessfulCoachResult()
        store.recordSuccessfulCoachResult()
        XCTAssertEqual(store.coachUsesRemainingToday, 1)
        store.recordSuccessfulCoachResult()
        XCTAssertEqual(store.coachUsesRemainingToday, 0)
        store.recordSuccessfulCoachResult()
        XCTAssertEqual(store.coachUsesRemainingToday, 0)
    }

    @MainActor
    func testPracticeDraftSurvivesAcrossWrites() {
        let root = FileManager.default.temporaryDirectory
            .appendingPathComponent("waitwise-draft-\(UUID().uuidString)", isDirectory: true)
        defer { try? FileManager.default.removeItem(at: root) }
        let store = LocalStore(testingDirectory: root)
        store.draft.drillSelections["ww-d1"] = DrillSelectionDraft(
            selectedTiles: [Tile(suit: .sou, rank: 3)],
            declaredNoWaits: false
        )
        XCTAssertEqual(store.draft.drillSelections["ww-d1"]?.selectedTiles.count, 1)
    }

    // MARK: - Premium + privacy boundaries

    @MainActor
    func testPremiumProductIDIsNonConsumableContract() {
        XCTAssertEqual(PremiumStore.productID, "waitwise_tenpai_pro")
    }

    func testInfoPlistDeclaresCameraAndPhotoOnly() throws {
        let bundle = Bundle.main
        let camera = bundle.object(forInfoDictionaryKey: "NSCameraUsageDescription") as? String
        let photoRead = bundle.object(forInfoDictionaryKey: "NSPhotoLibraryUsageDescription") as? String
        let photoWrite = bundle.object(forInfoDictionaryKey: "NSPhotoLibraryAddUsageDescription") as? String
        XCTAssertNotNil(camera)
        XCTAssertTrue(
            camera?.localizedCaseInsensitiveContains("table") == true
            || camera?.localizedCaseInsensitiveContains("HandStudy") == true
            || camera?.localizedCaseInsensitiveContains("Capture") == true
        )
        XCTAssertNotNil(photoRead)
        XCTAssertNotNil(photoWrite)
        XCTAssertNil(bundle.object(forInfoDictionaryKey: "NSMicrophoneUsageDescription"))
        XCTAssertNil(bundle.object(forInfoDictionaryKey: "NSUserTrackingUsageDescription"))
    }
