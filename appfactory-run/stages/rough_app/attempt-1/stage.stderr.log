import Foundation
import StoreKit

/// Tenpai Pro — yanran-compatible StoreKit 2 non-consumable (PM Commerce card).
/// Sells advanced shape packs, the mixed-shape challenge pack, the personal
/// custom Focus Deck, and expanded Guide chapters. Never sells answers or AI
/// access; the Foundation Drill → Wait Map → Recall loop is never gated.
@MainActor
final class PremiumStore: ObservableObject {
    static let productID = "waitwise_tenpai_pro"

    @Published private(set) var isPremium: Bool = false
    @Published private(set) var product: Product?
    @Published private(set) var loadFailed: Bool = false
    @Published private(set) var purchaseInFlight: Bool = false
    @Published private(set) var restoreInFlight: Bool = false

    private var updatesTask: Task<Void, Never>?

    init() {
        updatesTask = Task { [weak self] in
            await self?.listenForTransactions()
        }
        Task { await refresh() }
    }

    deinit {
        updatesTask?.cancel()
    }

    func refresh() async {
        await loadProduct()
        await refreshEntitlement()
    }

    private func loadProduct() async {
        do {
            let products = try await Product.products(for: [Self.productID])
            product = products.first
            loadFailed = products.isEmpty
        } catch {
            product = nil
            loadFailed = true
        }
    }

    func refreshEntitlement() async {
        var premium = false
        for await result in Transaction.currentEntitlements {
            if case .verified(let transaction) = result,
               transaction.productID == Self.productID,
               transaction.revocationDate == nil {
                premium = true
            }
        }
        isPremium = premium
    }

    enum PurchaseOutcome {
        case purchased, cancelled, failed, unavailable
    }

    /// Purchase never mutates current practice state; entitlement flips only on
    /// a verified transaction.
    func purchase() async -> PurchaseOutcome {
        guard let product else { return .unavailable }
        purchaseInFlight = true
        defer { purchaseInFlight = false }
        do {
            let result = try await product.purchase()
            switch result {
            case .success(let verification):
                guard case .verified(let transaction) = verification else { return .failed }
                await transaction.finish()
                await refreshEntitlement()
                return isPremium ? .purchased : .failed
            case .userCancelled:
                return .cancelled
            case .pending:
                return .cancelled
            @unknown default:
                return .failed
            }
        } catch {
            return .failed
        }
    }

    enum RestoreOutcome {
        case restored, noPurchase, failed
    }

    func restore() async -> RestoreOutcome {
        restoreInFlight = true
        defer { restoreInFlight = false }
        do {
            try await AppStore.sync()
        } catch {
            await refreshEntitlement()
            return isPremium ? .restored : .failed
        }
        await refreshEntitlement()
        return isPremium ? .restored : .noPurchase
    }

    var priceText: String {
        if let product { return product.displayPrice }
        return loadFailed ? "Unavailable" : "…"
    }

    private func listenForTransactions() async {
        for await result in Transaction.updates {
            if case .verified(let transaction) = result {
                await transaction.finish()
                await refreshEntitlement()
            }
        }
    }
}
